---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import '../styles/global.css';
import portrait from '../assets/portrait.webp';
import { getImage } from 'astro:assets';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  /** For pages that shouldn't be indexed (e.g. 404) */
  noindex?: boolean;
}
const {
  title = `${profile.shortName} — ${profile.title}`,
  description = profile.metaDescription,
  noindex = false,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Only emitted when SITE_URL is configured (see astro.config.mjs).
const canonical = Astro.site && !noindex ? new URL(base, Astro.site).href : undefined;
// Social platforms require an absolute image URL, so this also depends on SITE_URL.
const ogImage = Astro.site ? new URL(base + profile.ogImage, Astro.site).href : undefined;
const personPhoto = Astro.site ? new URL((await getImage({ src: portrait, width: 720, format: 'jpeg' })).src, Astro.site).href : undefined;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.title,
  email: `mailto:${profile.email}`,
  telephone: profile.phone,
  ...(canonical && { url: canonical }),
  ...(personPhoto && { image: personPhoto }),
  sameAs: [profile.links.github, profile.links.linkedin],
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Beni Suef University' },
  knowsAbout: ['Flutter', 'Dart', 'BLoC', 'Offline-first architecture', 'WebRTC', 'ESC/POS printing', 'CI/CD'],
};
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="color-scheme" content="dark light" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0a0b0e" />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="profile:first_name" content="Mohamed" />
    <meta property="profile:last_name" content="Gamal Yaseen" />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={`${profile.name}, ${profile.title}`} />
        <meta name="twitter:image" content={ogImage} />
      </>
    )}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href={`${base}favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="icon" href={`${base}favicon-192.png`} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') d.dataset.theme = t;
        } catch (e) {}
        // If the main script never runs, don't leave scroll-reveal content hidden.
        setTimeout(function () {
          if (!d.dataset.ready) d.classList.remove('js');
        }, 2500);
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="top"></div>
    <slot />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
