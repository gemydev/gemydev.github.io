---
interface Props {
  index: string;
  kicker: string;
  title: string;
  lead?: string;
  id?: string;
}
const { index, kicker, title, lead, id } = Astro.props;
---
<header class="section-header reveal">
  <p class="section-header__kicker"><span>{index}</span>{kicker}</p>
  <h2 id={id}>{title}</h2>
  {lead && <p class="section-header__lead">{lead}</p>}
</header>
