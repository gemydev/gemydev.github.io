---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import avatar from '../assets/avatar.webp';
import { profile } from '../data/profile';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__wash" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__name">
        <Image src={avatar} alt="" class="hero__avatar" width={44} height={44} densities={[1, 2]} loading="eager" />
        {profile.name}
      </p>
      <h1 id="hero-title">
        {profile.title}.<br />
        <span class="hero__accent">I build production apps end to end.</span>
      </h1>
      <p class="hero__intro">{profile.intro}</p>

      <div class="hero__ctas">
        <a class="btn btn--primary btn--lg" href="#projects">Explore projects <Icon name="arrow" size={16} /></a>
        <a class="btn btn--ghost btn--lg" href="#contact">Contact me</a>
      </div>

      <ul class="hero__social" aria-label="Profiles">
        <li><a href={profile.links.github} target="_blank" rel="noopener"><Icon name="github" size={17} />GitHub</a></li>
        <li><a href={profile.links.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" size={17} />LinkedIn</a></li>
        <li><a href={profile.links.whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" size={17} />WhatsApp</a></li>
        <li><a href={`mailto:${profile.email}`}><Icon name="mail" size={17} />Email</a></li>
      </ul>

      <ul class="facts" aria-label="At a glance">
        {profile.facts.map((f) => (
          <li>
            <strong>{f.value}</strong>
            <span class="facts__label">{f.label}</span>
            <span class="facts__note">{f.note}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <div class="editor">
        <div class="editor__bar">
          <span class="editor__dots"><i></i><i></i><i></i></span>
          <span class="editor__tab is-active">engineer.dart</span>
          <span class="editor__tab">projects.dart</span>
        </div>
        <pre class="editor__code"><code><span class="ln">1</span><span class="tk-k">import</span> <span class="tk-s">'package:flutter/material.dart'</span>;
<span class="ln">2</span>
<span class="ln">3</span><span class="tk-k">final</span> engineer = <span class="tk-t">FlutterEngineer</span>(
<span class="ln">4</span>  name: <span class="tk-s">'Mohamed Gamal'</span>,
<span class="ln">5</span>  role: <span class="tk-s">'Senior Flutter Developer'</span>,
<span class="ln">6</span>  since: <span class="tk-n">2021</span>,
<span class="ln">7</span>  platforms: [<span class="tk-s">'Android'</span>, <span class="tk-s">'iOS'</span>, <span class="tk-s">'Tablet'</span>],
<span class="ln">8</span>  state: [<span class="tk-t">Bloc</span>, <span class="tk-t">Cubit</span>, <span class="tk-t">Riverpod</span>],
<span class="ln">9</span>  strengths: [
<span class="ln">10</span>    <span class="tk-s">'offline-first sync'</span>,
<span class="ln">11</span>    <span class="tk-s">'real-time & WebRTC'</span>,
<span class="ln">12</span>    <span class="tk-s">'ESC/POS printing'</span>,
<span class="ln">13</span>    <span class="tk-s">'CI/CD & releases'</span>,
<span class="ln">14</span>  ],
<span class="ln">15</span>);
<span class="ln">16</span>
<span class="ln">17</span><span class="tk-k">await</span> engineer.<span class="tk-f">ship</span>(yourNextApp);<span class="caret"></span></code></pre>
        <div class="editor__status">
          <span><i class="ok"></i>flutter analyze · no issues</span>
          <span>Dart</span>
        </div>
      </div>
    </div>
  </div>
</section>
