---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import CodeWindow from './CodeWindow.astro';
import avatar from '../assets/avatar.webp';
import { profile } from '../data/profile';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__wash" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__name">
        <Image src={avatar} alt="" class="hero__avatar" width={44} height={44} densities={[1, 2]} loading="eager" />
        {profile.name}
      </p>
      <h1 id="hero-title">
        {profile.title}.<br />
        <span class="hero__accent">I build production apps end to end.</span>
      </h1>
      <p class="hero__intro">{profile.intro}</p>
      <ul class="hero__types" aria-label="Types of apps I've built">
        {profile.appTypes.map((t) => <li>{t}</li>)}
      </ul>

      <div class="hero__ctas">
        <a class="btn btn--primary btn--lg" href="#projects">Explore projects <Icon name="arrow" size={16} /></a>
        <a class="btn btn--ghost btn--lg" href="#contact">Contact me</a>
      </div>

      <ul class="hero__social" aria-label="Profiles">
        <li><a href={profile.links.github} target="_blank" rel="noopener"><Icon name="github" size={17} />GitHub</a></li>
        <li><a href={profile.links.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" size={17} />LinkedIn</a></li>
        <li><a href={profile.links.whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" size={17} />WhatsApp</a></li>
        <li><a href={`mailto:${profile.email}`}><Icon name="mail" size={17} />Email</a></li>
      </ul>

      <ul class="facts" aria-label="At a glance">
        {profile.facts.map((f) => (
          <li>
            <strong>{f.value}</strong>
            <span class="facts__label">{f.label}</span>
            <span class="facts__note">{f.note}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="hero__visual">
      <CodeWindow />
    </div>
  </div>
</section>
