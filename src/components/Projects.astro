---
import SectionHeader from './SectionHeader.astro';
import ProjectArt from './ProjectArt.astro';
import StoreLinks from './StoreLinks.astro';
import Icon from './Icon.astro';
import { featuredProjects, otherProjects } from '../data/projects';
---
<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="container">
    <SectionHeader
      index="03"
      kicker="Selected projects"
      title="Products I've built and shipped"
      lead="Featured apps across fintech, retail, marketplaces and legal-tech, with my role noted where I built the entire application, followed by more apps I've worked on."
      id="projects-title"
    />

    <div class="featured">
      {featuredProjects.map((p, i) => (
        <article class:list={['feature reveal', { 'feature--flip': i % 2 === 1 }]}>
          {p.art && <ProjectArt variant={p.art} />}
          <div class="feature__body">
            <p class="feature__meta">
              <span>{p.domain}</span>
              {p.nda && <span class="badge badge--muted"><Icon name="lock" size={12} />Under NDA</span>}
            </p>
            <h3>{p.name}{p.localName && <span class="feature__local" lang="ar" dir="rtl">{p.localName}</span>}</h3>
            <p class="feature__org">
              {[p.org, p.period, p.platforms].filter(Boolean).join(' · ')}
            </p>
            <p class="feature__summary">{p.summary}</p>
            {p.contribution && (
              <p class="feature__role"><span>My role</span>{p.contribution}</p>
            )}
            {p.highlights && (
              <ul class="feature__points">
                {p.highlights.map((h) => <li>{h}</li>)}
              </ul>
            )}
            <ul class="tags" aria-label="Technologies and themes">
              {p.tags.map((t) => <li>{t}</li>)}
            </ul>
            {p.links && <StoreLinks links={p.links} project={p.name} />}
            {p.nda && <p class="feature__note">Screenshots and details will be shared once the product launches.</p>}
          </div>
        </article>
      ))}
    </div>

    <h3 class="subheading reveal">More projects</h3>
    <div class="projects-grid">
      {otherProjects.map((p) => (
        <article class="project reveal">
          <p class="project__domain">{p.domain}</p>
          <h4>{p.name}{p.localName && <> · <span lang="ar" dir="rtl">{p.localName}</span></>}</h4>
          {p.org && <p class="project__org">{p.org}</p>}
          <p class="project__summary">{p.summary}</p>
          {p.contribution && <p class="project__role"><span>My role</span>{p.contribution}</p>}
          <div class="project__foot">
            <ul class="tags tags--sm">{p.tags.map((t) => <li>{t}</li>)}</ul>
            {p.links && <StoreLinks links={p.links} project={p.name} compact />}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
