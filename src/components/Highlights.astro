---
import SectionHeader from './SectionHeader.astro';
import { highlights } from '../data/highlights';
---
<section class="section section--alt" id="highlights" aria-labelledby="highlights-title">
  <div class="container">
    <SectionHeader
      index="04"
      kicker="Engineering highlights"
      title="What I bring beyond the UI"
      lead="How I work, and the products where it shows."
      id="highlights-title"
    />
    <ol class="highlights">
      {highlights.map((h, i) => (
        <li class="highlight reveal">
          <span class="highlight__num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{h.title}</h3>
          <p class="highlight__body">{h.body}</p>
          <p class="highlight__proof"><span>{h.kind === 'practice' ? 'Tools' : 'Shown in'}</span>{h.proof}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
